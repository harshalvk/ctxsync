{
  "name": "ctxsync",
  "version": "0.1.0",
  "module": "index.ts",
  "description": "Keeps AI agent context files (AGENTS.md, CLAUDE.md, .cursorrules) in sync with your codebase, automatically.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ctxsync": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --outdir ./dist --target bun --minify",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "citty": "^0.1.6"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "trustedDependencies": ["@biomejs/biome", "lefthook"]
}
